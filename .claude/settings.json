{
  "permissions": {
    "allow": [
      "PowerShell(powershell -File .\\build.ps1 -ValidateOnly*)",
      "PowerShell(powershell -File .\\build.ps1 -Test*)",
      "PowerShell(powershell -File .\\build.ps1 -Check*)",
      "PowerShell(powershell -File .\\build.ps1 -Audit*)",
      "PowerShell(powershell -File .\\build.ps1 -Generate*)",
      "PowerShell(powershell -File .\\build.ps1 -FetchPicture*)",
      "PowerShell(powershell -File .\\build.ps1 -ConvertPictures*)",
      "PowerShell(powershell -File .\\build.ps1 -SyncMirrors*)",
      "PowerShell(powershell -File .\\build.ps1 -Package*)",
      "PowerShell(powershell -File .\\tests\\Run-Tests.ps1*)",
      "PowerShell(*Test-HoiKnowledge.ps1*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "Write(scratch/**)",
      "Write(research/**)",
      "Bash(powershell*build.ps1 -ValidateOnly*)",
      "Bash(powershell*build.ps1 -Test*)",
      "Bash(powershell*build.ps1 -Check*)",
      "Bash(powershell*build.ps1 -Audit*)",
      "Bash(powershell*build.ps1 -Generate*)",
      "Bash(powershell*build.ps1 -FetchPicture*)",
      "Bash(powershell*build.ps1 -ConvertPictures*)",
      "Bash(powershell*build.ps1 -SyncMirrors*)",
      "Bash(powershell*build.ps1 -Package*)",
      "Bash(powershell*Run-Tests.ps1*)",
      "Bash(*Test-HoiKnowledge.ps1*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(*build.ps1*-Deploy*)",
      "PowerShell(*build.ps1*-DevLink*)",
      "PowerShell(*build.ps1*-Clean*)",
      "PowerShell(*push-wiki.ps1*)",
      "Bash(*build.ps1*-Deploy*)",
      "Bash(*build.ps1*-DevLink*)",
      "Bash(*build.ps1*-Clean*)",
      "Bash(*push-wiki.ps1*)",
      "PowerShell(powershell -File .\\build.ps1 -PreviewPictures*)",
      "Bash(powershell*build.ps1 -PreviewPictures*)",
      "PowerShell(powershell -File .\\build.ps1 -RenderEvents*)",
      "Bash(powershell*build.ps1 -RenderEvents*)",
      "PowerShell(Get-Help .\\build.ps1*)",
      "PowerShell(robocopy . scratch\\rehearsal *)",
      "Bash(robocopy . scratch*rehearsal *)",
      "PowerShell(Remove-Item -Recurse -Force scratch\\rehearsal)",
      "Bash(rm -rf scratch/rehearsal)",
      "PowerShell(*New-HoiThumbnail.ps1*)",
      "Bash(*New-HoiThumbnail.ps1*)",
      "PowerShell(powershell -File .\\build.ps1 -RemovePicture*)",
      "Bash(powershell*build.ps1 -RemovePicture*)",
      "PowerShell(powershell -File .\\build.ps1 -ApplyPlan*)",
      "Bash(powershell*build.ps1 -ApplyPlan*)",
      "PowerShell(*Test-WorkshopText.ps1*)",
      "Bash(*Test-WorkshopText.ps1*)",
      "PowerShell(*Sync-WorkshopRegions.ps1*)",
      "Bash(*Sync-WorkshopRegions.ps1*)",
      "PowerShell(*Sync-WorkshopCrossLinks.ps1*)",
      "Bash(*Sync-WorkshopCrossLinks.ps1*)",
      "PowerShell(*Test-HoiConditions.ps1*)",
      "Bash(*Test-HoiConditions.ps1*)",
      "PowerShell(*Find-HoiDoc.ps1*)",
      "Bash(*Find-HoiDoc.ps1*)",
      "PowerShell(*Find-HoiUsage.ps1*)",
      "Bash(*Find-HoiUsage.ps1*)",
      "PowerShell(*Get-HoiState.ps1*)",
      "Bash(*Get-HoiState.ps1*)",
      "PowerShell(*Get-HoiCountryHistory.ps1*)",
      "Bash(*Get-HoiCountryHistory.ps1*)",
      "PowerShell(*Get-HoiCountry.ps1*)",
      "Bash(*Get-HoiCountry.ps1*)"
    ],
    "ask": [
      "Read(tools/EventPacks.ps1)",
      "Read(tools/HoiModBuild.ps1)",
      "PowerShell(*build.ps1*-NewPack*)",
      "PowerShell(*build.ps1*-PublishSteam*)",
      "PowerShell(*build.ps1*-InstallSteamCmd*)",
      "PowerShell(*steamcmd*)",
      "Bash(*build.ps1*-NewPack*)",
      "Bash(*build.ps1*-PublishSteam*)",
      "Bash(*build.ps1*-InstallSteamCmd*)",
      "Bash(*steamcmd*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Protect-ProjectFiles.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Show-PlanState.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.claude/skills/**)",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Sync-SkillMirrors.ps1\"",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Write(.claude/skills/**)",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Sync-SkillMirrors.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
